# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Clover payments (server-only, never prefix with NEXT_PUBLIC_)
CLOVER_API_TOKEN=YOUR-ECOMMERCE-PRIVATE-TOKEN
CLOVER_MERCHANT_ID=YOUR-MERCHANT-ID
CLOVER_WEBHOOK_SECRET=YOUR-HOSTED-CHECKOUT-SIGNING-SECRET
# Sandbox by default. Set to the production API host when going live.
# CLOVER_API_BASE=https://apisandbox.dev.clover.com
# Your public https site address, used for Clover's redirect URLs.
SITE_URL=https://YOUR-DOMAIN
# Supabase service-role key (Project Settings -> API). Used only by the payment routes.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Email for membership renewal reminders. Use the same SMTP details you give Supabase for sign-up emails.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=YOUR-SMTP-USERNAME
SMTP_PASS=YOUR-SMTP-PASSWORD
EMAIL_FROM="Club Mahj <hello@your-domain.com>"
# Any long random string. Vercel sends it with the daily reminder job; without it the job refuses to run.
CRON_SECRET=YOUR-LONG-RANDOM-STRING
