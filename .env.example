# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Clover payments (server-only, never prefix with NEXT_PUBLIC_)
CLOVER_API_TOKEN=YOUR-ECOMMERCE-PRIVATE-TOKEN
CLOVER_MERCHANT_ID=YOUR-MERCHANT-ID
CLOVER_WEBHOOK_SECRET=YOUR-HOSTED-CHECKOUT-SIGNING-SECRET
# Sandbox by default. Set to the production API host when going live.
# CLOVER_API_BASE=https://apisandbox.dev.clover.com
# Your public https site address, used for Clover's redirect URLs.
SITE_URL=https://YOUR-DOMAIN
# Same address, exposed to the browser for the signup confirmation-email link.
# Leave unset locally to use whatever origin you're browsing from.
NEXT_PUBLIC_SITE_URL=https://YOUR-DOMAIN
# Supabase service-role key (Project Settings -> API). Used only by the payment routes.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
